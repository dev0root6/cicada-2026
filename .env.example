# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# On Vercel, set the same keys under Settings > Environment Variables.

# --- Admin auth ---------------------------------------------------------------
# Signs session cookies. Any 32+ char random string; rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# One variable per admin: ADMIN_USER_<NAME>. The username is the suffix,
# lowercased — ADMIN_USER_KING1 means you sign in as "king1".
# Generate a password and its digest with:  npm run hash-password
# Format: pbkdf2:<iterations>:<saltHex>:<hashHex>   (colons, not $ — see lib/auth/crypto.ts)
ADMIN_USER_KING1=
ADMIN_USER_KING2=

# --- Database -----------------------------------------------------------------
# Set automatically by the Vercel Neon integration (Vercel > Storage).
# Apply the schema once with: npm run db:migrate
DATABASE_URL=

# --- Cashfree payments --------------------------------------------------------
# From your Cashfree merchant dashboard. Use sandbox keys until you go live.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# --- Email (Gmail) --------------------------------------------------------------
# Sends the "you're on the list" confirmation and the "registrations are open"
# alert. Create an app password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification). Copy and subject lines live in data/emails.ts.
MAIL_APP_PASSWD=
# The Gmail address the app password belongs to. Defaults to the contact
# address in data/site.ts when unset.
MAIL_USER=
